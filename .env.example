# ==========================================
# SAMVAD PERCEPTION ADVISORY - ENVIRONMENT CONFIG
# ==========================================

# Runtime Environment
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database (PostgreSQL / PgBouncer)
DATABASE_URL="postgresql://samvad_user:samvad_secret_password@localhost:5432/samvad_perception?schema=public"
# DIRECT_URL is optional, used for direct migrations if using Supabase or PgBouncer in transaction mode
# DIRECT_URL="postgresql://samvad_user:samvad_secret_password@localhost:5432/samvad_perception?schema=public"

# Redis (Caching & Rate Limiting)
REDIS_URL="redis://localhost:6379"

# Enterprise Security & Authentication
ADMIN_API_KEY="super_secure_enterprise_advisory_secret_key_samvad_2026"
CORS_ALLOWED_ORIGINS="http://localhost:3000"

# Rate Limiting Policies
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Public Client Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="SAMVAD Perception Advisory"
NEXT_PUBLIC_ENABLE_ANALYTICS=false
