{
  "name": "samvad-perception-advisory",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise PR, Strategic Communications, and Reputation Management Platform",
  "scripts": {
    "dev": "pnpm --filter @samvad/web dev",
    "build": "pnpm --filter @samvad/database db:generate && pnpm -r --filter \"./packages/*\" run build && pnpm --filter @samvad/web build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm --filter @samvad/database db:generate && pnpm -r run typecheck",
    "test": "vitest run",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:generate": "pnpm --filter @samvad/database db:generate",
    "db:push": "pnpm --filter @samvad/database db:push",
    "db:seed": "pnpm --filter @samvad/database db:seed"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
